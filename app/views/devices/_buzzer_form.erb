<section class="buzzer-device" aria-labelledby="buzzer-device-title">
  <div class="buzzer-device__status-card">
    <div class="buzzer-device__header">
      <div>
        <p class="buzzer-device__eyebrow">THIẾT BỊ CẢNH BÁO</p>
        <h3 id="buzzer-device-title" class="buzzer-device__title">🔔 <%= @device.name %></h3>
        <p class="buzzer-device__chip-id"><%= @device.chip_id %></p>
      </div>
      <% is_online = @buzzer_details.online? %>
      <span class="buzzer-device__status-badge buzzer-device__status-badge--<%= is_online ? 'online' : 'offline' %>">
        <%= is_online ? '● Online' : '○ Offline' %>
      </span>
    </div>

    <div class="buzzer-device__stats-grid">
      <div class="buzzer-device__stat-card">
        <span class="buzzer-device__stat-label">PIR đang liên kết</span>
        <strong class="buzzer-device__stat-value"><%= @buzzer_source_devices.size %></strong>
      </div>
      <div class="buzzer-device__stat-card">
        <span class="buzzer-device__stat-label">Lần trigger gần nhất</span>
        <strong class="buzzer-device__stat-value buzzer-device__stat-value--date">
          <%= @buzzer_events.first&.occurred_at&.in_time_zone('Asia/Ho_Chi_Minh')&.strftime('%d/%m/%Y %H:%M:%S') || 'Chưa có dữ liệu' %>
        </strong>
      </div>
    </div>

    <div class="buzzer-device__test-action">
      <%= button_to '🔔 Test Buzzer',
                    test_buzzer_device_path(@device),
                    method: :post,
                    class: 'buzzer-device__test-button',
                    data: {
                      turbo_confirm: 'Buzzer sẽ phát âm theo thời lượng đã cấu hình. Bạn muốn tiếp tục?',
                      buzzer_test_button: true
                    },
                    form: { data: { buzzer_test_form: true } } %>
      <small>Chỉ xác nhận Rails đã gửi lệnh đến MQTT broker; chưa có xác nhận từ Buzzer.</small>
    </div>
  </div>

  <div class="buzzer-device__card">
    <div class="buzzer-device__card-header">
      <div>
        <h4>PIR kích hoạt Buzzer</h4>
        <p>Các PIR có cấu hình trigger trỏ đến <code><%= @device.chip_id %></code>.</p>
      </div>
      <span class="buzzer-device__count"><%= @buzzer_source_devices.size %> thiết bị</span>
    </div>

    <% if @buzzer_source_devices.any? %>
      <ul class="buzzer-device__source-list">
        <% @buzzer_source_devices.each do |pir_device| %>
          <% trigger_config = @buzzer_details.trigger_for(pir_device) %>
          <li>
            <span class="buzzer-device__source-icon">◉</span>
            <span>
              <strong><%= pir_device.name %></strong>
              <small><%= pir_device.chip_id %> · Kênh <%= trigger_config['relay_index'] || 0 %> · <%= trigger_config['longlast'] || '—' %> ms</small>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="buzzer-device__empty-state">
        <span>🔗</span>
        Chưa có PIR nào được cấu hình để kích hoạt Buzzer này.
      </div>
    <% end %>
  </div>

  <div class="buzzer-device__card">
    <div class="buzzer-device__card-header">
      <div>
        <h4>Lịch sử lệnh từ PIR</h4>
        <p>20 sự kiện chuyển động gần nhất đã gửi lệnh đến Buzzer này.</p>
      </div>
    </div>

    <% if @buzzer_events.any? %>
      <div class="table-responsive">
        <table class="buzzer-device__table">
          <thead>
            <tr>
              <th>Thời gian</th>
              <th>PIR nguồn</th>
              <th>Thời lượng</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% @buzzer_events.each do |event| %>
              <% payload = event.parsed_payload %>
              <tr>
                <td><%= event.occurred_at.in_time_zone('Asia/Ho_Chi_Minh').strftime('%d/%m/%Y %H:%M:%S') %></td>
                <td>
                  <strong><%= event.device.name %></strong>
                  <small><%= event.device.chip_id %></small>
                </td>
                <td><%= payload['longlast'] || '—' %> ms</td>
                <td><span class="buzzer-device__sent-badge">Đã nhận motion</span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="buzzer-device__empty-state">
        <span>📭</span>
        Chưa có lịch sử lệnh từ PIR cho Buzzer này.
      </div>
    <% end %>
  </div>
</section>
