<!-- PIR Motion Sensor Card -->
<div class="pir-device__status-card">

  <!-- Header with device name -->
  <div class="pir-device__header">
    <h3 class="pir-device__title">
      🔍 <%= @device.name %>
    </h3>
    <% is_online = @device_info&.dig('update_at').to_i > 5.minutes.ago.to_i %>
    <span class="pir-device__status-badge pir-device__status-badge--<%= is_online ? 'online' : 'offline' %>">
      <%= is_online ? '● Online' : '○ Offline' %>
    </span>
  </div>

  <!-- Status Grid -->
  <div class="pir-device__stats-grid">

    <!-- Last Motion -->
    <div class="pir-device__stat-card">
      <div class="pir-device__stat-label">
        Phát hiện cuối
      </div>
      <div class="pir-device__stat-value <%= 'pir-device__stat-value--empty' unless @device_events&.any? %>">
        <% if @device_events&.any? %>
          <%= @device_events.first.occurred_at.in_time_zone('Asia/Ho_Chi_Minh').strftime('%d/%m/%Y %H:%M:%S') %>
        <% else %>
          Chưa có dữ liệu
        <% end %>
      </div>
    </div>

    <!-- Local IP -->
    <div class="pir-device__stat-card">
      <div class="pir-device__stat-label">
        Địa chỉ IP
      </div>
      <div class="pir-device__stat-value <%= 'pir-device__stat-value--empty' unless @device_info&.dig('local_ip').present? %>">
        <%= @device_info&.dig('local_ip').present? ? @device_info['local_ip'] : '—' %>
      </div>
    </div>

    <!-- App Version -->
    <div class="pir-device__stat-card">
      <div class="pir-device__stat-label">
        Phiên bản
      </div>
      <div class="pir-device__stat-value">
        <%= @device_info&.dig('app_version') || 'v1.0.0' %>
      </div>
    </div>

  </div>

</div>

<!-- Motion Events History -->
<div class="pir-device__history-card">

  <div class="pir-device__history-header">
    <h4 class="pir-device__history-title">
      📊 Lịch sử phát hiện chuyển động
    </h4>
    <span class="pir-device__history-subtitle">
      20 sự kiện gần nhất
    </span>
  </div>

  <% if @device_events&.any? %>
    <div class="table-responsive">
      <table class="pir-device__table">
        <thead>
          <tr>
            <th style="width: 30%;">Thời gian</th>
            <th style="width: 25%;">IP nguồn</th>
            <th style="width: 45%;">User Agent</th>
          </tr>
        </thead>
        <tbody>
          <% @device_events.first(20).each do |event| %>
            <% payload = JSON.parse(event.payload || '{}') rescue {} %>
            <tr>
              <td>
                <%= event.occurred_at.in_time_zone('Asia/Ho_Chi_Minh').strftime('%d/%m/%Y %H:%M:%S') %>
              </td>
              <td>
                <%= payload['triggered_from'] || '—' %>
              </td>
              <td>
                <%= payload['user_agent'] || '—' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="pir-device__empty-state">
      <div class="pir-device__empty-state-icon">🔍</div>
      Chưa có sự kiện phát hiện chuyển động nào.
    </div>
  <% end %>

</div>

<div class="pir-device__chart-card pir-device__chart-card--motion">
  <div class="pir-device__history-header">
    <div>
      <h4 class="pir-device__history-title">📈 Phát hiện chuyển động</h4>
      <p class="pir-device__chart-description">Số lần phát hiện theo giờ trong 24 giờ gần nhất.</p>
    </div>
    <span class="pir-device__history-subtitle">24 giờ</span>
  </div>

  <div class="pir-device__chart-canvas-wrap">
    <canvas
      id="pir-motion-chart"
      data-labels="<%= json_escape(@pir_motion_chart[:labels].to_json) %>"
      data-values="<%= json_escape(@pir_motion_chart[:values].to_json) %>"
      aria-label="Biểu đồ số lần phát hiện chuyển động theo giờ"
      role="img"></canvas>
  </div>
</div>
